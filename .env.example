# ── Airflow core ──────────────────────────────────────────────────────────────
# Fernet key for encrypting connections/variables stored in the metadata DB.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME

# Connection string for Airflow's metadata database (the Postgres service below).
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# Executor — LocalExecutor is fine for a single-machine setup.
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Disable example DAGs so the UI isn't cluttered.
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ── Airflow webserver ────────────────────────────────────────────────────────
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME

# ── Postgres (used by Airflow metadata DB) ───────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ── Pipeline settings (used by DAGs in later milestones) ─────────────────────
DATA_DIR=/opt/airflow/data
# TZ=Europe/Rome

# ── Bus feed auth (optional — only needed if bus feeds are added later) ──────
# The tram feeds are publicly accessible and require no credentials.
# GTFS_RT_USERNAME=
# GTFS_RT_PASSWORD=

# ── Cloud variant (optional) ─────────────────────────────────────────────────
# Everything below is unset by default: the pipeline runs fully local
# (local Parquet + DuckDB) with no cloud account.

# 1. Raw zone in GCS — the ingestion DAGs mirror every Parquet file here.
#    Uploads are skipped entirely while this is unset.
#    Credentials come from Application Default Credentials
#    (gcloud auth application-default login, or a service-account key file).
# GCS_BUCKET=my-padova-transit-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/secrets/gcp-sa.json

# 2. dbt reading the raw zone from GCS instead of the local disk.
#    DuckDB reaches GCS through its S3-compatible interoperability API,
#    which needs an HMAC key pair (Cloud Storage > Settings > Interoperability).
# DBT_TARGET=cloud
# GCS_HMAC_KEY_ID=
# GCS_HMAC_SECRET=

# 3. Publishing the finished marts to BigQuery (make publish-bq).
#    Skipped while GCP_PROJECT is unset.
# GCP_PROJECT=my-gcp-project
# BQ_DATASET=padova_transit
# BQ_LOCATION=europe-west1
